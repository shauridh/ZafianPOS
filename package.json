  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.3",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.46.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitejs/plugin-rsc": "^0.5.30",
    "typescript": "^5.7.2",
    "vite": "^8.1.5",
    "wrangler": "^4.113.0"
  },
  "type": "module"
}
