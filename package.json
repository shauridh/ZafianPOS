{
  "name": "sabana-pos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "vinext build && node scripts/copy-hosting.mjs",
    "start": "next start",
    "lint": "next lint",
    "dev:vinext": "vinext dev --port 3001",
